#, python-brace-format
msgid "Not a valid {obj_type}."
msgstr "Neplatný objekt typu {obj_type}."

#, python-brace-format
msgid "Not a valid {awareness} {obj_type}."
msgstr "Neplatná hodnota typu {awareness} {obj_type}."

#, python-brace-format
msgid "\"{input}\" cannot be formatted as a {obj_type}."
msgstr "„{input}“ nelze převést na hodnotu typu {obj_type}."

msgid "Not a valid boolean."
msgstr "Neplatná booleovská hodnota."

msgid "Missing data for required field."
msgstr "Chybí povinné pole."

msgid "Field may not be null."
msgstr "Pole nesmí být prázdné (null)."

msgid "Invalid value."
msgstr "Neplatná hodnota."

msgid "Not a valid date."
msgstr "Neplatné datum."

#, python-brace-format
msgid "\"{input}\" cannot be formatted as a date."
msgstr "„{input}“ nelze převést na datum."

msgid "Special numeric values (nan or infinity) are not permitted."
msgstr "Speciální číselné hodnoty (NaN nebo nekonečno) nejsou povoleny."

msgid "Not a valid mapping type."
msgstr "Neplatný mapovací typ."

msgid "Not a valid email address."
msgstr "Neplatná e-mailová adresa."

#, python-brace-format
msgid "Must be one of: {choices}."
msgstr "Musí být jedna z hodnot: {choices}."

msgid "Not a valid IP address."
msgstr "Není platná IP adresa."

msgid "Not a valid IP interface."
msgstr "Není platné IP rozhraní."

msgid "Not a valid IPv4 address."
msgstr "Není platná IPv4 adresa."

msgid "Not a valid IPv4 interface."
msgstr "Není platné IPv4 rozhraní."

msgid "Not a valid IPv6 address."
msgstr "Neplatná adresa IPv6."

msgid "Not a valid IPv6 interface."
msgstr "Neplatné rozhraní IPv6."

msgid "Not a valid integer."
msgstr "Neplatné celé číslo."

msgid "Not a valid list."
msgstr "Neplatný seznam."

msgid "Invalid type."
msgstr "Neplatný typ."

msgid "Not a valid number."
msgstr "Neplatné číslo."

msgid "Number too large."
msgstr "Číslo je příliš velké."

msgid "Not a valid string."
msgstr "Neplatný řetězec."

msgid "Not a valid utf-8 string."
msgstr "Neplatný řetězec v kódování UTF-8."

msgid "Not a valid period of time."
msgstr "Neplatný časový interval."

#, python-brace-format
msgid "{input!r} cannot be formatted as a timedelta."
msgstr "{input!r} nelze převést na časový interval."

msgid "Not a valid tuple."
msgstr "Neplatná n-tice (tuple)."

msgid "Not a valid URL."
msgstr "Neplatná URL adresa."

msgid "Not a valid UUID."
msgstr "Neplatné UUID."

msgid "Not a valid dictionary."
msgstr "Neplatný slovník."

msgid "Translation not found for "
msgstr "Překlad nebyl nalezen pro "

msgid "Only one identifier per scheme is allowed."
msgstr "Pro každé schéma je povolen pouze jeden identifikátor."

msgid "Duplicated identifier entry is not allowed."
msgstr "Duplicitní hodnota identifikátoru není povolena."

msgid "No valid scheme recognized for identifier."
msgstr "Pro identifikátor nebylo rozpoznáno platné schéma."

#, python-brace-format
msgid "Invalid {scheme} identifier."
msgstr "Neplatný identifikátor schématu {scheme}."

msgid "Invalid scheme."
msgstr "Neplatné schéma."

#, python-brace-format
msgid "One or více of the choices you made was in: {values}."
msgstr "Jedna nebo více zvolených hodnot byla mezi: {values}."

#, python-brace-format
msgid "One or more of the choices you made was not in: {choices}."
msgstr "Jedna nebo více zvolených hodnot nebyla mezi: {choices}."

#, python-brace-format
msgid "Must be equal to {other}."
msgstr "Hodnota musí být rovna \"{other}\"."

#, python-brace-format
msgid "Shorter than minimum length {min}."
msgstr "Hodnota je kratší než minimální délka {min}."

#, python-brace-format
msgid "Longer than maximum length {max}."
msgstr "Hodnota je delší než maximální délka {max}."

#, python-brace-format
msgid "Length must be between {min} and {max}."
msgstr "Délka musí být mezi {min} a {max} znaky/prvky."

#, python-brace-format
msgid "Length must be {equal}."
msgstr "Délka musí být rovna {equal}."

msgid "Invalid input."
msgstr "Neplatný vstup."

#, python-brace-format
msgid "Must be {min_op} {{min}}."
msgstr "Musí být {min_op} {{min}}."

#, python-brace-format
msgid "Must be {max_op} {{max}}."
msgstr "Musí být {max_op} {{max}}."

#, python-brace-format
msgid "Must be {min_op} {{min}} and {max_op} {{max}}."
msgstr "Musí být {min_op} {{min}} a {max_op} {{max}}."

msgid "greater than or equal to"
msgstr "větší nebo rovno"

msgid "greater than"
msgstr "větší než"

msgid "less than or equal to"
msgstr "menší nebo rovno"

msgid "less than"
msgstr "menší než"

msgid "String does not match expected pattern."
msgstr "Řetězec neodpovídá očekávanému vzoru."

#, python-brace-format
msgid "Must be greater than or equal to {min} and less than or equal to {max}."
msgstr "Musí být větší nebo rovno {min} a menší nebo rovno {max}."

#, python-brace-format
msgid "Must be greater than to {min} and less than or equal to {max}."
msgstr "Musí být větší než {min} a menší nebo rovno {max}."

#, python-brace-format
msgid "Must be greater than or equal to {min} and less than {max}."
msgstr "Musí být větší nebo rovno {min} a menší než {max}."

#, python-brace-format
msgid "Must be greater than to {min} and less than {max}."
msgstr "Musí být větší než {min} a menší než {max}."

#, python-brace-format
msgid "Must be less than or equal to {max}."
msgstr "Musí být menší nebo rovno {max}."

#, python-brace-format
msgid "Must be less than {max}."
msgstr "Musí být menší než {max}."

#, python-brace-format
msgid "Must be greater than or equal to {min}."
msgstr "Musí být větší nebo rovno {min}."

#, python-brace-format
msgid "Must be greater than {min}."
msgstr "Musí být větší než {min}."

